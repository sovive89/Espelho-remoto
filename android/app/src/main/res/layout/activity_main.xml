<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="24dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Espelho Remoto" android:textSize="22sp" android:textStyle="bold" android:paddingBottom="4dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Compartilhe a tela deste aparelho e assista no navegador de outro." android:textSize="14sp" android:paddingBottom="20dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Endereco do servidor" android:textStyle="bold" />
<EditText android:id="@+id/inputServer" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="https://seuservidor.onrender.com" android:inputType="textUri" android:paddingBottom="12dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="E-mail para receber o link (opcional)" android:textStyle="bold" />
<EditText android:id="@+id/inputEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="voce@exemplo.com" android:inputType="textEmailAddress" android:paddingBottom="20dp" />
<Button android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Iniciar compartilhamento" />
<Button android:id="@+id/btnStop" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Parar" android:enabled="false" />
<TextView android:id="@+id/txtStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="20dp" android:text="Pronto." android:textSize="14sp" />
<TextView android:id="@+id/txtLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:textIsSelectable="true" android:textColor="#2b6cff" android:textSize="14sp" />
</LinearLayout></ScrollView>